# ── Telegram ─────────────────────────────────────────────
BOT_TOKEN=
ADMIN_USER_IDS=

# ── Storage ──────────────────────────────────────────────
DB_PATH=./data/autopilot.db
SCREENSHOT_DIR=./data/screenshots
LOG_DIR=./data/logs

# ── Automation ───────────────────────────────────────────
MAX_SESSIONS=10
MAX_TABS=8

# ── Proxies ──────────────────────────────────────────────
PROXY_SOURCES=geonode,proxyscrape
PROXY_REFRESH_MINUTES=10
CUSTOM_PROXIES=

# ── Health server (Railway) ──────────────────────────────
HEALTH_PORT=8080

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO